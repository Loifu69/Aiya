# Optional: override the built-in Firebase project (see src/utils/firebase.ts).
# Copy this file to .env.local and fill in your own Firebase web app config.
# If these are empty, Aiya uses the default "aiya-60746" project.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Server-only (Vercel env vars) for background reminders, see README "Pengingat saat aplikasi ditutup".
# Never put real values in this file.
FIREBASE_SERVICE_ACCOUNT=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
CRON_SECRET=""
VAPID_SUBJECT=""
